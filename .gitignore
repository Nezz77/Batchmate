# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Keep generated Prisma client committed — the .node engine binary is needed for packaging
# /src/generated/prisma-client is intentionally tracked
/src/generated/prisma

# App Data & Privacy (Do NOT commit personal student data)
Images/
public/students/
Resultsheets/
result-sheets/
*.xlsx
*.csv

# Databases
*.db
*.sqlite
prisma/*.db
prisma/*.sqlite

# Python
.venv/
.venv

# Build Outputs
/dist/
/dist-electron/
/release/
/.vite/
/dmg-output/

# macOS Installers & Archives
*.dmg
*.zip
*.pkg
*.tar.gz
*.tar.bz2

# Photos & Images (student/personal data)
*.jpg
*.jpeg
*.png
*.gif
*.webp
*.bmp
*.tiff
*.tif
*.heic
*.heif
*.raw
# Allow app icons and public assets
!app_icons/**
!public/icons/**
!public/*.png
!public/*.ico
!public/*.svg
!src/assets/**

# PDFs (transcripts, GPA reports, marksheets)
*.pdf

# GPA / Academic Data files
*gpa*
*GPA*
*marksheet*
*Marksheet*
*transcript*
*Transcript*
*grades*
*Grades*
*result*
*Result*
Default_bday_template/
